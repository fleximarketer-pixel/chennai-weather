<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/push-lakes.sh at 8 am, 1 pm and 7 pm. Install with:
     cp scripts/com.tnrainwatch.lakes.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.tnrainwatch.lakes.plist -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tnrainwatch.lakes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/karthikramani/orca/projects/chennai-weather/scripts/push-lakes.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/Users/karthikramani/Library/Logs/tn-rain-watch-lakes.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/karthikramani/Library/Logs/tn-rain-watch-lakes.log</string>
</dict>
</plist>
